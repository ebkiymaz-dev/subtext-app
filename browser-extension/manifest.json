{
  "manifest_version": 3,
  "name": "Subtext — Conversation Assist",
  "version": "0.1.1",
  "description": "Tap Subtext to review a visible conversation locally and optionally request AnswerAce replies.",
  "permissions": ["storage"],
  "icons": { "128": "icon-128.png" },
  "action": { "default_title": "Use Subtext to analyze text", "default_icon": { "128": "icon-128.png" } },
  "host_permissions": ["https://neonjungletools.com/*", "https://web.whatsapp.com/*", "https://www.instagram.com/*", "https://www.messenger.com/*", "https://www.facebook.com/*", "https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://web.whatsapp.com/*", "https://www.instagram.com/*", "https://www.messenger.com/*", "https://www.facebook.com/*", "https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*"],
    "js": ["content.js"], "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["panel.html", "panel.js", "panel.css"],
    "matches": ["https://web.whatsapp.com/*", "https://www.instagram.com/*", "https://www.messenger.com/*", "https://www.facebook.com/*", "https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*"]
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://neonjungletools.com; style-src 'self'; frame-src 'none'; base-uri 'none'" }
}
