# ============================================================================
#  SUBTEXT — environment
# ============================================================================
#  Copy to `.env.local`:   copy .env.example .env.local
#  Every slot can stay empty. Subtext is FULLY USABLE with no provider at all —
#  see the note below, because for this app that is a feature, not a shortfall.
#
#  >>> THE ONE RULE THAT MATTERS <<<
#
#  Anything prefixed NEXT_PUBLIC_ is INLINED INTO THE BROWSER BUNDLE and shipped
#  to every visitor. A provider key in a NEXT_PUBLIC_ variable is a PUBLISHED
#  key. So:
#
#     NEXT_PUBLIC_*   — modes and flags only. Never a secret.
#     everything else — server-only. Read exclusively by
#                       app/api/capabilities/route.ts via lib/providers.ts.
#
#  That endpoint reports configuration state only. NO MESSAGE TEXT IS EVER SENT
#  TO IT — which is what keeps "your conversation never leaves this device"
#  literally true.
# ----------------------------------------------------------------------------


# ── What runs with NO provider configured ──────────────────────────────────
# EVERYTHING THE FREE TIER SHOWS. Segmentation, the crisis screen, the whole
# psycholinguistic signal layer (bids and responses, register asymmetry, closing
# vs continuing, style matching, reciprocation), every category score, the
# headline, the evidence lines, the competing readings, "what wasn't said" and
# Coach. All on-device, always, and none of it is a placeholder for a model.
#
# A provider adds exactly ONE thing: the PREMIUM "deep read"
# (POST /api/deep-read) — one structured model call per analysis producing the
# psychological layer, schema-validated, with every quote checked against your
# paste. It is opt-in per analysis, behind a consent line, and it is the only
# part of Subtext that sends text off the device.
#
# So a missing key is not a broken app. It is the fully private one.


# ── Provider selection ─────────────────────────────────────────────────────
#   LLM_PROVIDER = auto | groq | gemini | ollama | openai | claude
# `auto` picks the cheapest configured provider, free first. For THIS app the
# recommended value is `ollama`, because a local model is the only option that
# keeps the privacy promise literally true.
LLM_PROVIDER=auto


# ── RECOMMENDED: Ollama — local, private by construction ───────────────────
# UNLOCKS : Model-quality inferred reads and interpretation prose, with NOTHING
#           leaving this machine. For an app whose input is private messages,
#           this is the setup to want — "never leaves your device" stops being
#           a policy and becomes an architectural fact.
# GET IT  : https://ollama.com/download   — no account, no key, no card
#           then:  ollama pull qwen2.5:14b-instruct
# FREE    : No quota at all. The limit is your GPU; requests are serial.
# HARDWARE: On Windows, Ollama needs AMD's ROCm/HIP stack and supports discrete
#           Radeon RX/PRO cards ONLY — Ryzen AI APUs are excluded. ~8 GB VRAM
#           runs a 7-8B model, ~16 GB runs a 14B. Below 8 GB, don't bother.
# QUALITY : Genuinely good at this job — short outputs, a fixed ~10-category
#           schema, easy to spot-check. This is the one place in the estate
#           where a local model is arguably BETTER than a hosted one.
OLLAMA_HOST=
OLLAMA_MODEL=qwen2.5:14b-instruct


# ── Hosted alternative: Groq ───────────────────────────────────────────────
# GET IT  : https://console.groq.com/keys           (free, no card)
# PRIVACY : Groq does not retain or train on your data — but message text WOULD
#           leave this machine. Local Ollama is the stronger promise here.
GROQ_API_KEY=

# ── Gemini — what the deep read currently runs on ──────────────────────────
# UNLOCKS : POST /api/deep-read. Gemini's NATIVE endpoint is used rather than
#           its OpenAI-compatible one, because it is the only free option that
#           will enforce a response SCHEMA rather than merely promise JSON —
#           one fewer class of failure for the validator to catch.
# LADDER  : gemini-3.6-flash -> gemini-flash-latest -> gemini-2.0-flash.
#           Model ids here are PERISHABLE — Google retires them out from under
#           a pinned name, and ListModels disagrees with generateContent about
#           which are alive. The route walks past 404/503 for that reason.
#           Ladder verified against the live API 2026-07-29 in nj_providers.
# COST    : 1 call per deep read. Free tier, no card.
#
# >>> PRIVACY, PLAINLY: on the FREE tier Google may use prompts and responses
# to improve its products, and HUMAN REVIEWERS MAY SEE THEM. Subtext's input is
# private messages. The app's consent line says the text leaves the device —
# make sure it also says WHERE it goes before you ship this to anyone but
# yourself. Local Ollama above is the only setup with no such trade. <<<
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

OPENAI_API_KEY=
ANTHROPIC_API_KEY=


# ── Client-visible mode flags (safe to expose — no secrets) ────────────────
NEXT_PUBLIC_LLM_MODE=mock
NEXT_PUBLIC_BILLING_MODE=mock


# ── Billing (free to set up; takes a cut only on a sale) ───────────────────
# https://app.lemonsqueezy.com/register
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
