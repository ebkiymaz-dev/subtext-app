{
  "name": "subtext-app",
  "version": "0.1.0",
  "private": true,
  "description": "SUBTEXT — private conversation reader with on-device analysis, screenshot OCR, and an optional local archive.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:extension": "node scripts/build-extension.mjs",
    "test:companion": "node scripts/companion-core-test.mjs",
    "test:wallets": "node scripts/wallet-connect-test.mjs",
    "eval": "tsc -p tsconfig.eval.json && node .eval-out/scripts/eval.js",
    "eval:coach": "tsc -p tsconfig.eval.json && node .eval-out/scripts/coach-context-eval.js",
    "eval:personalized-coach": "tsc -p tsconfig.eval.json && node .eval-out/scripts/personalized-coach-eval.js",
    "eval:coach:live": "tsc -p tsconfig.eval.json && node scripts/live-coach-provider-eval.mjs",
    "eval:mobile": "tsc -p tsconfig.eval.json && node .eval-out/scripts/mobile-fuzz.js",
    "eval:ocr-group": "tsc -p tsconfig.eval.json && node .eval-out/scripts/ocr-group-eval.js",
    "eval:multilingual": "tsc -p tsconfig.eval.json && node scripts/multilingual-extraction-eval.mjs",
    "eval:reliability": "tsc -p tsconfig.eval.json && node .eval-out/scripts/reliability-eval.js"
  },
  "dependencies": {
    "franc": "6.2.0",
    "next": "^16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/node": "^20.14.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.2",
    "eslint": "9.39.2",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3"
  }
}
