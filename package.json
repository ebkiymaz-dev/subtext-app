{
  "name": "subtext-app",
  "version": "0.1.0",
  "private": true,
  "description": "SUBTEXT — private conversation reader with on-device analysis, screenshot OCR, and an optional local archive.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "eval": "tsc -p tsconfig.eval.json && node .eval-out/scripts/eval.js",
    "eval:mobile": "tsc -p tsconfig.eval.json && node .eval-out/scripts/mobile-fuzz.js",
    "eval:ocr-group": "tsc -p tsconfig.eval.json && node .eval-out/scripts/ocr-group-eval.js",
    "eval:deep": "tsc -p tsconfig.eval.json && node .eval-out/scripts/eval.js --deep"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3"
  }
}
